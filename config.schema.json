{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://getsynth.sh/config.schema.json",
    "title": "synth config",
    "description": "Schema for $XDG_CONFIG_HOME/synth/config.json. Every key is optional; an absent one keeps the built-in default.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URL of this schema. Written into a new config file so an editor knows what it is reading."
        },
        "system_prompt": {
            "type": "string",
            "description": "Replaces the base instructions entirely."
        },
        "think": {
            "type": "boolean",
            "default": true,
            "description": "Ask for reasoning output. Turn off for models that do not support it."
        },
        "auto_approve_safe_commands": {
            "type": "boolean",
            "default": true,
            "description": "Let a preset of read-only shell commands run without a prompt."
        },
        "approvals": {
            "enum": [
                "ask",
                "auto",
                "all"
            ],
            "default": "ask",
            "description": "Who decides a call that would otherwise ask. 'ask' puts it to you. 'auto' has the session's model judge it, blocking what looks destructive, outside the project or outside the task, and hands decisions back to you after 3 blocks in a row or 20 in a session. 'all' runs everything, paths outside the project included: for a machine set aside for the agent. `PreToolUse` hooks still run under each."
        },
        "debug_log": {
            "type": "string",
            "description": "Append every request and reply to this file."
        },
        "max_turn_ms": {
            "type": "number",
            "default": 1800000,
            "minimum": 0,
            "description": "How long one turn may run. 0 disables it."
        },
        "max_turn_tokens": {
            "type": "number",
            "default": 2000000,
            "minimum": 0,
            "description": "Tokens one turn may spend, prompt and completion together. 0 disables it."
        },
        "max_stall_ms": {
            "type": "number",
            "default": 120000,
            "minimum": 0,
            "description": "How long the provider may send nothing before the turn is given up on. 0 disables it."
        },
        "skill_paths": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "default": [],
            "description": "Extra directories to look for skills in, searched in order."
        },
        "ollama": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "num_ctx": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Window to ask ollama to load a model with. Omit for the model's advertised maximum; 0 leaves the choice to the server."
                },
                "host": {
                    "type": "string",
                    "deprecated": true,
                    "description": "Still read so an old config keeps working. Where a provider points lives in the database now."
                },
                "model": {
                    "type": "string",
                    "deprecated": true,
                    "description": "Still read so an old config keeps working. The chosen model lives in the database now."
                },
                "api_key": {
                    "type": "string",
                    "deprecated": true,
                    "description": "Still read so an old config keeps working. Keys belong in auth.json now."
                },
                "think": {
                    "type": "boolean",
                    "deprecated": true,
                    "description": "Still read so an old config keeps working. Use the top-level think instead."
                },
                "debug_log": {
                    "type": "string",
                    "deprecated": true,
                    "description": "Still read so an old config keeps working. Use the top-level debug_log instead."
                }
            },
            "description": "Ollama-specific settings. Everything but num_ctx is the old single-provider shape, kept so an existing config still loads."
        },
        "database_path": {
            "type": "string",
            "default": "synth.db",
            "description": "Where sessions live."
        },
        "hooks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "SessionStart": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "SessionEnd": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "UserPromptSubmit": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "PreToolUse": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "PermissionRequest": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "PostToolUse": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "PreCompact": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "PostCompact": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "SubagentStart": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "SubagentStop": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "Stop": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "Interrupt": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "PreModelRequest": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                },
                "PostModelRequest": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/hook"
                            },
                            {
                                "$ref": "#/$defs/hookGroup"
                            }
                        ]
                    }
                }
            },
            "description": "Additive lifecycle hooks. Every definition needs explicit trust after upgrade or changes."
        },
        "hook_timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "default": 30000,
            "description": "How long a hook command may run before it is killed.",
            "maximum": 86400000
        },
        "mcp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "servers": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/mcpServer"
                    }
                }
            },
            "description": "MCP servers. See README."
        },
        "web": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "search_api_key": {
                    "type": "string",
                    "description": "Brave Search API key for the web_search tool. Without one the tool scrapes DuckDuckGo's HTML results page, which needs no key but is throttled after a handful of searches. BRAVE_API_KEY overrides it."
                }
            },
            "description": "Settings for the web tools."
        },
        "prune": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "delete_after_days": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Sessions idle longer than this are deleted outright, taking their messages and tool calls with them. 0 never deletes a session."
                },
                "shed_after_days": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 30,
                    "description": "Sessions idle longer than this keep their transcript but lose stored reasoning and the full tool output behind each card. What the model was shown stays. 0 keeps every payload."
                }
            },
            "description": "What a prune throws away, on startup and on /prune. Ages are in days since a session was last touched."
        },
        "bell": {
            "enum": [
                "unfocused",
                "always",
                "never"
            ],
            "default": "unfocused",
            "description": "When a finished turn says so, by desktop notification and BEL. 'unfocused' needs the terminal to report focus; one that does not never rings, so use 'always' there. Under tmux both need focus-events and allow-passthrough on."
        },
        "commit_trailer": {
            "type": "string",
            "default": "Co-Authored-By: synth <noreply@getsynth.sh>",
            "description": "The trailer the model is asked to end its commit messages with, in a git project. An empty string asks for none."
        }
    },
    "$defs": {
        "hook": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "command"
            ],
            "properties": {
                "matcher": {
                    "type": "string",
                    "default": "",
                    "description": "Exact tool name to match. Empty or absent matches every tool."
                },
                "command": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Shell command run from the project root."
                },
                "timeout_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000
                },
                "transcript": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "mcpServer": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "oneOf": [
                {
                    "required": [
                        "command"
                    ]
                },
                {
                    "required": [
                        "url"
                    ]
                }
            ],
            "properties": {
                "command": {
                    "type": "string",
                    "description": "A command to run a child process."
                },
                "args": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Arguments passed to that command."
                },
                "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "A remote server over Streamable HTTP."
                },
                "headers": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Extra headers for the remote server."
                }
            }
        },
        "hookHandler": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "enum": [
                        "command",
                        "mcp_tool"
                    ],
                    "default": "command"
                },
                "command": {
                    "type": "string",
                    "minLength": 1
                },
                "timeout_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000
                },
                "async": {
                    "type": "boolean",
                    "default": false
                },
                "transcript": {
                    "type": "boolean",
                    "default": false
                },
                "server": {
                    "type": "string",
                    "minLength": 1
                },
                "tool": {
                    "type": "string",
                    "minLength": 1
                },
                "arguments": {}
            },
            "oneOf": [
                {
                    "required": [
                        "command"
                    ],
                    "properties": {
                        "type": {
                            "const": "command"
                        }
                    }
                },
                {
                    "required": [
                        "type",
                        "server",
                        "tool",
                        "arguments"
                    ],
                    "properties": {
                        "type": {
                            "const": "mcp_tool"
                        },
                        "async": {
                            "const": false
                        }
                    }
                }
            ]
        },
        "hookGroup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "hooks"
            ],
            "properties": {
                "matcher": {
                    "type": "string",
                    "default": "",
                    "description": "Regex or * for tool events; ignored for other events."
                },
                "hooks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/hookHandler"
                    }
                }
            }
        }
    },
    "allowComments": false,
    "allowTrailingCommas": false
}
